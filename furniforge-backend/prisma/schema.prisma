generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid())
  clientRegNo         String?       @unique
  designerRegNo       String?       @unique
  role                Role
  firstName           String
  lastName            String
  email               String        @unique
  phone               String        @unique
  avatar              String?
  passwordHash        String?
  isVerified          Boolean       @default(false)
  oauthProvider       String?
  oauthId             String?
  address             Json?
  occupation          String?
  education           String?
  projectCount        Int           @default(0)
  totalRevenue        Decimal       @default(0)
  rating              Float         @default(0)
  isBlocked           Boolean       @default(false)
  leads               Lead[]        @relation("ClientLeads")
  assignedLeads       Lead[]        @relation("DesignerLeads")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  createdDeliverables Deliverable[]
  templates           Template[]
}

model Lead {
  id                   String       @id @default(uuid())
  leadRegNo            String       @unique
  name                 String
  email                String
  phone                String
  location             String?
  source               LeadSource
  status               LeadStatus
  projectsInterestedIn String[]
  packageType          PackageType?
  clientId             String?
  client               User?        @relation("ClientLeads", fields: [clientId], references: [id])
  assignedDesignerId   String?
  assignedDesigner     User?        @relation("DesignerLeads", fields: [assignedDesignerId], references: [id])
  assignedAt           DateTime?
  convertedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Deliverable {
  id          String     @id @default(uuid())
  name        String     @unique
  description String
  icon        String
  isActive    Boolean    @default(true)
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  templates   Template[]
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([isActive])
  @@index([deletedAt])
}

model Template {
  id            String        @id @default(uuid())
  deliverableId String
  deliverable   Deliverable   @relation(fields: [deliverableId], references: [id])
  name          String
  description   String
  isActive      Boolean       @default(true)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  tabs          TemplateTab[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  @@unique([deliverableId, name])
  @@index([deliverableId])
}

model TemplateTab {
  id           String          @id @default(uuid())
  templateId   String
  template     Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int
  isActive     Boolean @default(true)
  fields       TemplateField[]
  deletedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  @@unique([templateId, name])
  @@index([templateId])
}

model TemplateField {
  id            String              @id @default(uuid())
  tabId         String
  tab           TemplateTab         @relation(fields: [tabId], references: [id], onDelete: Cascade)
  label         String
  fieldKey      String
  fieldType     FieldType
  options       String[]            @default([])
  defaultValue  String?
  isActive      Boolean             @default(true)
  isRequired    Boolean             @default(false)
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  requestValues RequestFieldValue[]
  @@unique([tabId, label])
  @@unique([tabId, fieldKey])
  @@index([tabId])
}

model RequestFieldValue {
  id        String        @id @default(uuid())
  requestId String
  fieldId   String
  field     TemplateField @relation(fields: [fieldId], references: [id])
  value     Json
  createdAt DateTime      @default(now())
  @@index([fieldId])
}

model Counter {
  id    String @id
  value Int
}

enum Role {
  ADMIN
  CLIENT
  DESIGNER
}

enum LeadStatus {
  UNASSIGNED
  ASSIGNED
  DESIGNING
  PROPOSAL_SENT
  CONVERTED
  LOST
}

enum LeadSource {
  EXTERNAL
  REFERRAL
  SELF_REGISTERED
}

enum PackageType {
  BASIC
  STANDARD
  PREMIUM
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  DATE
  FILE
  IMAGE
  EMAIL
  PHONE
}
